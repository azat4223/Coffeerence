<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Создать новый промокод"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etNewPromoCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Код (например, SUMMER20)"
        android:inputType="textCapCharacters"/>

    <EditText
        android:id="@+id/etDiscountPercent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Размер скидки в % (например, 20)"
        android:inputType="number"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnSavePromo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Сохранить промокод"
        android:layout_marginTop="24dp"/>
</LinearLayout>