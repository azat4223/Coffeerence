<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Панель владельца"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- Кнопка управления меню и ценами -->
    <Button
        android:id="@+id/btnManageMenu"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Управление меню и ценами"
        android:layout_marginBottom="16dp"/>

    <!-- Кнопка аналитики -->
    <Button
        android:id="@+id/btnAnalytics"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Просмотр аналитики продаж"
        android:layout_marginBottom="16dp"/>

    <!-- Кнопка создания промокода -->
    <Button
        android:id="@+id/btnCreatePromo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Создать промокод"/>

</LinearLayout>