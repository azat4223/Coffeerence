<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Coffeerence"
        tools:targetApi="31">

        <!-- 1. Стартовый экран (Выбор роли: Клиент, Сотрудник, Админ) -->
        <activity
            android:name="com.example.coffeerence.RoleSelectionActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.example.coffeerence.MenuActivity" />
        <activity android:name="com.example.coffeerence.CheckoutActivity" />
        <activity android:name="com.example.coffeerence.PaymentActivity" />
        <activity android:name="com.example.coffeerence.LoyaltyActivity" />
        <activity android:name="com.example.coffeerence.ProductDetailActivity" />


        <activity android:name="com.example.coffeerence.EmployeeActivity" />


        <activity android:name="com.example.coffeerence.AdminActivity" />
        <activity android:name="com.example.coffeerence.AnalyticsActivity" />
        <activity android:name="com.example.coffeerence.CreatePromoActivity" />
        <activity android:name="com.example.coffeerence.ManageMenuActivity" />
    </application>
</manifest>